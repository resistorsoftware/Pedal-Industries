{% comment %}EasyLockdownSnippetRevision:20260804192858-e937da3057f8{% endcomment %}
{% unless request.design_mode %}
{% if elhDefines %}  {% assign elhDefines = elhDefines | split: '--elhResultItem--' %}  {% if elhDefines[0] == '1' %}{% assign easylockdownON = true %}{% endif %}  {% if elhDefines[1] == '1' %}{% assign easylockdownHiddenPurchase = true %}{% endif %}  {% assign easylockdownRedirectURL = elhDefines[2] %}  {% assign easylockdownPage404Title = elhDefines[3] %}  {% assign easylockdownPage404Message = elhDefines[4] %}  {% assign easylockdownPasswordNote = elhDefines[5] %}  {% assign easylockdownPasswordPlaceholder = elhDefines[6] %}  {% assign easylockdownPriceSelectors = elhDefines[7] %}  {% if elhDefines[8] == '1' %}{% assign easylockdownHidePrice = true %}{% endif %}  {% assign easylockdownHidePriceLinkText = elhDefines[9] %}  {% assign easylockdownHidePriceLinkUrl = elhDefines[10] %}{% endif %}{% capture easylockdownPage404Content %}<div class="easylockdown404-content-container"><div class="easylockdown404-content-wrapper"><div class="easylockdown404-title-holder"><span class="easylockdown-title-404">{{ easylockdownPage404Title }}</span></div><div class="easylockdown404-content-holder rte"><div class="easylockdown-message-404">{{ easylockdownPage404Message }}</div></div></div></div>{% endcapture %}

{% if easylockdownON %}
  <div id='easylockdown404' style='display:none;'>{{ easylockdownPage404Content }}</div>
  <script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        if(typeof easylockdown != 'object' || !easylockdown.isReadyToUse) {
          try { document.getElementById('easylockdown404').style.display = ''; } catch(e) {}
        }
      }, 2000);
    });
  </script>
{% else %}
  <div class='easylockdown-content' style='display:none;'>{{ content_for_layout }}</div>
  <div id='easylockdown404' style='display:none;'>{{ easylockdownPage404Content }}</div>
  {% render 'easylockdown_password_form', easylockdownPasswordNote: easylockdownPasswordNote, easylockdownPasswordPlaceholder: easylockdownPasswordPlaceholder %}

  <script type="text/javascript" id='easylockdown-helper'>
    var easylockdownLoaded = false;
    document.addEventListener('easylockdown_loaded', function() {
      easylockdownLoaded = true;
      easylockdown.clientContentToggle({% unless easylockdownHiddenPurchase %}true{% endunless %});
    }, {once: true});
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(function() {
        if(!easylockdownLoaded) { for(var blocks=document.querySelectorAll("#easylockdown-password-form, #easylockdown-hpbtn-style, .easylockdown-auto-hl-styles, .easylockdown-custom-hl-styles, #easylockdown404"),_easylockdownElementIndex=0;_easylockdownElementIndex<blocks.length;_easylockdownElementIndex++)blocks[_easylockdownElementIndex].remove();
        var elContent = document.querySelector('.easylockdown-content')
        if(elContent) {
          elContent.removeAttribute('style');
        }
        var elStyle = document.getElementById('easylockdown-plugin-style');
        if(elStyle) {
          elStyle.remove();
        }
        console.info("EasyLockdown is not loaded");
        }
      }, 350);
    });
  </script>
{% endif %}

{% else %}
{{ content_for_layout }}
{% endunless %}